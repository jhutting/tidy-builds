<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Build section first, because why not. -->
    <build>
        <finalName>sort</finalName>
        <plugins>
            <plugin>
                <version>3.14.0</version>
                <artifactId>maven-compiler-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <groupId>org.apache.maven.plugins</groupId>
                <configuration>
                    <argLine>-Xmx512m</argLine>
                </configuration>
            </plugin>
            <plugin>
                <version>3.4.2</version>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.9.0</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <version>${commons-io.version}</version>
            <artifactId>commons-io</artifactId>
            <groupId>commons-io</groupId>
        </dependency>
        <dependency>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
            <groupId>com.google.guava</groupId>
        </dependency>
        <dependency>
            <scope>test</scope>
            <version>${junit.jupiter.version}</version>
            <artifactId>junit-jupiter</artifactId>
            <groupId>org.junit.jupiter</groupId>
        </dependency>
        <dependency>
            <artifactId>commons-lang3</artifactId>
            <groupId>org.apache.commons</groupId>
        </dependency>
        <dependency>
            <version>${slf4j.version}</version>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <scope>runtime</scope>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <groupId>ch.qos.logback</groupId>
        </dependency>
        <dependency>
            <version>${assertj.version}</version>
            <groupId>org.assertj</groupId>
            <scope>test</scope>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <name>sort</name>

    <packaging>jar</packaging>

    <profiles>
        <profile>
            <id>fast</id>
            <properties>
                <skipTests>true</skipTests>
            </properties>
        </profile>
    </profiles>

    <artifactId>sort</artifactId>

    <properties>
        <slf4j.version>2.0.16</slf4j.version>
        <guava.version>33.3.1-jre</guava.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <logback.version>1.5.12</logback.version>
        <assertj.version>3.26.3</assertj.version>
        <commons-io.version>2.17.0</commons-io.version>
        <jackson.version>2.18.1</jackson.version>
        <surefire.version>3.5.2</surefire.version>
        <junit.jupiter.version>5.11.3</junit.jupiter.version>
    </properties>

    <description>A module whose POM elements are in the wrong order.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <version>${jackson.version}</version>
                <artifactId>jackson-bom</artifactId>
                <type>pom</type>
                <scope>import</scope>
                <groupId>com.fasterxml.jackson</groupId>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <parent>
        <version>01.00.00-SNAPSHOT</version>
        <artifactId>tidy-builds</artifactId>
        <groupId>nl.jhutting.talks</groupId>
    </parent>

    <url>https://github.com/jhutting/tidy-builds</url>

    <modelVersion>4.0.0</modelVersion>

</project>
